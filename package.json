{
  "name": "cli-agent-bridge",
  "version": "0.1.0",
  "description": "A terminal-first LLM gateway with fallback and activity auditing.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cli-agent-bridge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./providers": "./dist/providers/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.4.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.7.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
